# Backend development environment

# Preferred single-URI config. If you have Mongo running locally, this will work.
# If you do not have Mongo available, the API will still start, but /health/db will report error until you configure this.
MONGODB_URI=mongodb://localhost:27017/network
MONGODB_DB_NAME=network
MONGODB_COLLECTION=device
MONGODB_CONNECT_TIMEOUT_MS=5000
# MONGODB_TLS=true

# CORS allowlist: include your frontend preview origins (scheme+host+port)
# Ensure this matches the actual frontend preview host and protocol.
FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000,https://vscode-internal-37855-beta.beta01.cloud.kavia.ai:3000
