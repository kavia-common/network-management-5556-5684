# Example environment variables for BackendAPIService

# Mongo (preferred: single URI)
MONGODB_URI=mongodb://localhost:27017/network
# Optional overrides
MONGODB_DB_NAME=network
MONGODB_COLLECTION=device
MONGODB_CONNECT_TIMEOUT_MS=5000
# MONGODB_TLS=true

# CORS allowlist (comma-separated exact origins; scheme+host+port), choose one of:
# FRONTEND_ORIGIN_ALLOWLIST or CORS_ALLOWED_ORIGINS (both supported; latter preferred)
# Local dev:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Preview hosts (append to existing list, do not replace):
# CORS_ALLOWED_ORIGINS=http://vscode-internal-34539-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-26250-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-28439-beta.beta01.cloud.kavia.ai:3001
# Enable if using cookie-based auth; defaults to false
# CORS_SUPPORTS_CREDENTIALS=true
