# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=3001

# MongoDB (preferred single URI)
# Example: mongodb://localhost:27017/network
MONGODB_URI="mongodb://localhost:27017/network"
# Optional overrides
# MONGODB_DB_NAME="network"
# MONGODB_COLLECTION="device"
# MONGODB_TLS=false
# MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS configuration
# Priority:
# 1) BACKEND_CORS_ORIGINS (comma separated list)
# 2) FRONTEND_ORIGIN (single)
# 3) FRONTEND_ORIGIN_ALLOWLIST / CORS_ALLOWED_ORIGINS (legacy)
# Defaults to http://localhost:3000 if none set.
# Examples:
# BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# FRONTEND_ORIGIN="http://localhost:3000"
# Legacy examples:
# FRONTEND_ORIGIN_ALLOWLIST="http://localhost:3000"
# CORS_ALLOWED_ORIGINS="http://localhost:3000"
CORS_SUPPORTS_CREDENTIALS=false
