# Backend API Service Environment Example
# Copy this file to .env and adjust values. The app auto-loads .env via python-dotenv.

# Preferred single-URI configuration (MongoDB Atlas or local)
# Local example:
# MONGODB_URI=mongodb://localhost:27017/network
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster-host>/network?retryWrites=true&w=majority&appName=myapp
MONGODB_URI=mongodb://localhost:27017/network

# Optional overrides
# Default DB name is "network". To retain an older DB, set "network_devices".
# MONGODB_DB_NAME=network
# Collection used by the app
# MONGODB_COLLECTION=device
# TLS toggle (true/false)
# MONGODB_TLS=false
# Connection timeout (ms)
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Fallback individual settings (used only if MONGODB_URI is not provided)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin

# CORS allowlist — include your frontend origin(s) (scheme + host + port, comma-separated)
# Local dev examples:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# vscode-internal preview examples (update hosts as needed for your session):
CORS_ALLOWED_ORIGINS=https://vscode-internal-28439-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-28439-beta.beta01.cloud.kavia.ai:3001

# If cookie-based auth is needed in the future, enable credentials:
# CORS_SUPPORTS_CREDENTIALS=false
