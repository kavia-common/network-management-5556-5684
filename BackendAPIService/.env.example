# BackendAPIService environment variables

# Preferred single URI (Atlas or standard). Including a DB path here (e.g., /network) is supported.
# If both MONGODB_URI and MONGODB_DB_NAME are provided, MONGODB_DB_NAME takes precedence for the selected DB.
MONGODB_URI=mongodb://localhost:27017/network
# Override database name (default: network)
MONGODB_DB_NAME=network
# Devices collection (do not change unless necessary)
MONGODB_COLLECTION=device
# Connection options
MONGODB_CONNECT_TIMEOUT_MS=5000
# Enable TLS if required (e.g., Atlas)
# MONGODB_TLS=true

# Alternative construction (only used if MONGODB_URI is not set)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin

# CORS allowlist (comma-separated exact origins)
# FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000

# Notes:
# - Default DB name is 'network'. Previous default was 'network_devices'; your existing data may be in that DB.
#   Set MONGODB_DB_NAME=network_devices or update your URI path to continue using it.
# - Index creation runs on the chosen DB's collection (device). No collection names are changed.
