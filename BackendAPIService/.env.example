# Example environment configuration for BackendAPIService

# Preferred single-URI configuration for MongoDB
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=myapp
MONGODB_DB_NAME=network_devices
MONGODB_COLLECTION=device
MONGODB_CONNECT_TIMEOUT_MS=5000
# MONGODB_TLS=true

# CORS allowlist (comma-separated). Add your frontend preview origin(s) here.
# Keep precise origins (scheme + host + port). Do not use wildcards.
# Example local dev:
# FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000
# Kavia vscode-internal preview (added as requested):
FRONTEND_ORIGIN_ALLOWLIST=http://vscode-internal-34539-beta.beta01.cloud.kavia.ai:3000
