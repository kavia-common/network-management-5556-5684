# BackendAPIService environment example
# Copy this file to .env and fill in values.

# Preferred single URI form:
MONGODB_URI=mongodb://localhost:27017/network_devices
MONGODB_DB_NAME=network_devices
# Optional collection name for indexes and default collection usage
MONGODB_COLLECTION=device
# TLS toggle and connect timeout (ms)
MONGODB_TLS=false
MONGODB_CONNECT_TIMEOUT_MS=5000

# Alternative: build from parts (used ONLY if MONGODB_URI is not set)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin

# If your environment only provides REACT_APP_* variables, the backend will
# now automatically map them to the corresponding MONGODB_* variables at runtime.
# Uncomment and set as needed:
# REACT_APP_MONGODB_URI=mongodb://localhost:27017/network_devices
# REACT_APP_MONGODB_DB_NAME=network_devices
# REACT_APP_MONGODB_USERNAME=
# REACT_APP_MONGODB_PASSWORD=
# REACT_APP_MONGODB_OPTIONS=
