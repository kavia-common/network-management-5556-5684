# BackendAPIService environment variables example
# Copy this file to .env and fill in appropriate values for your environment.

# MongoDB connection (preferred single URI)
# Supports standard and Atlas:
# - mongodb://localhost:27017/network
# - mongodb+srv://<user>:<pass>@<cluster-host>/network?retryWrites=true&w=majority&appName=myapp
MONGODB_URI=

# Optional: override the database name (even if specified in the URI path)
# Default if unset: "network"
# MONGODB_DB_NAME=network

# Collection to use for devices (default: "device")
# MONGODB_COLLECTION=device

# Enable TLS if your MongoDB requires it (e.g., Atlas sometimes is auto-configured via URI)
# MONGODB_TLS=true

# Connection timeout in milliseconds (default: 5000)
# MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS configuration: comma-separated list of allowed origins (scheme + host + port)
# Example local dev:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Optional: enable credentials if you implement cookie-based auth
# CORS_SUPPORTS_CREDENTIALS=false
