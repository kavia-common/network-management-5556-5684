# Flask
FLASK_ENV=development
FLASK_DEBUG=1
# Port the Flask app will bind to (default 3001 if unset)
PORT=3001

# MongoDB (Atlas-ready). Preferred single variable configuration.
# Example (Local): mongodb://localhost:27017/network
# Example (Atlas): mongodb+srv://<user>:<pass>@cluster0.mongodb.net/network?retryWrites=true&w=majority&appName=myapp
MONGODB_URI="mongodb://localhost:27017/network"

# Optional: override database name if not present in the URI path (or to force a specific DB)
# If the URI includes a db segment (/network), that will be used; otherwise fallback to this name.
# MONGODB_DB_NAME="network_devices"

# Optional collection name used by the app (defaults to "device")
# MONGODB_COLLECTION="device"

# Optional TLS and timeout
# MONGODB_TLS=false
# MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS: allow all origins for development
ALLOWED_ORIGINS="*"
# CORS_SUPPORTS_CREDENTIALS=false
