# BackendAPIService .env example
# Copy to BackendAPIService/.env and adjust values for your environment.

# MongoDB (preferred single-URI configuration)
# MONGODB_URI=mongodb://localhost:27017/network_devices
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=myapp
MONGODB_DB_NAME=network_devices
# MONGODB_COLLECTION=device
# MONGODB_TLS=false
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Optional: Build URI from parts if MONGODB_URI is not provided
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin

# CORS allowlist for frontend origins (comma-separated).
# If unset, the backend defaults to the following safe development origins:
#   http://localhost:3000,
#   http://127.0.0.1:3000,
#   http://vscode-internal-34539-beta.beta01.cloud.kavia.ai:3000,
#   http://vscode-internal-34539-beta.beta01.cloud.kavia.ai:3001
# To add your preview host, override this value accordingly.
# Example:
# FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000,https://my-preview.example.com:3000
FRONTEND_ORIGIN_ALLOWLIST=
