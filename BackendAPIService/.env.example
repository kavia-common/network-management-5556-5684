# BackendAPIService - Example environment variables
# Copy this file to .env and adjust values accordingly.

# Preferred: full MongoDB URI (Atlas-compatible)
# Example (Atlas): mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=<app>
# Example (Local): mongodb://localhost:27017/network_devices
MONGODB_URI=

# Database name to use within the cluster/instance
# If not provided, defaults to "network_devices"
MONGODB_DB_NAME=network_devices

# Optional: Collection name used by the application (default: device)
# MONGODB_COLLECTION=device

# Optional security and timeouts
# Set to "true" to enable TLS/SSL. Often not required when using mongodb+srv URIs,
# as SRV records usually include TLS params.
# MONGODB_TLS=true

# Connection timeout in milliseconds (default: 5000)
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Optional advanced configuration (used only when MONGODB_URI is not set)
# MONGODB_HOST=
# MONGODB_PORT=
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin

# Some deployment environments may expose variables with REACT_APP_ prefix.
# The backend will automatically map these to MONGODB_* if the latter are not set.
# REACT_APP_MONGODB_URI=
# REACT_APP_MONGODB_DB_NAME=
