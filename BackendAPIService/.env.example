# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=3001

# CORS
# Preferred: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000
# Alternatively:
# FRONTEND_ORIGIN=http://localhost:3000
# Legacy:
# FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Credentials support (only if you use cookies across origins)
# CORS_SUPPORTS_CREDENTIALS=false

# MongoDB (optional for startup; required for DB access)
# Preferred single URI (Atlas-ready or local):
# MONGODB_URI=mongodb://localhost:27017/network
# Optional overrides:
# MONGODB_DB_NAME=network
# MONGODB_COLLECTION=device
# MONGODB_TLS=false
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Fallback parts (used when MONGODB_URI is not set)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=
