# Example .env for BackendAPIService

# MongoDB connection (preferred single URI)
# Works with Atlas (mongodb+srv://) or local (mongodb://)
# Local example:
#   mongodb://localhost:27017/network
# Atlas example:
#   mongodb+srv://<user>:<pass>@<cluster-host>/network?retryWrites=true&w=majority&appName=myapp
MONGODB_URI=mongodb://localhost:27017/network

# Optional: override database name even if present in the URI path
# MONGODB_DB_NAME=network
# Collection used by the app (indexes are created)
# MONGODB_COLLECTION=device

# Optional TLS and timeout
# MONGODB_TLS=false
# MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS configuration
# The backend is configured to allow all origins by default for simplicity during development.
# To restrict CORS to specific origins, set this to a comma-separated list:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# To enable cookie credentials in CORS (default: false):
# CORS_SUPPORTS_CREDENTIALS=false
