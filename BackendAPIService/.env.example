# Preferred single-URI configuration
# Supports mongodb+srv:// for Atlas or mongodb:// for standard deployments.
MONGODB_URI=mongodb://localhost:27017/network_devices

# Optional overrides
MONGODB_DB_NAME=network
# Collection used by the app; indexes are created here. Default: device
MONGODB_COLLECTION=device

# Connection behavior
# Enable TLS by setting to true when required by your deployment (e.g., Atlas).
# MONGODB_TLS=true
# Server selection/connect timeout in milliseconds (default 5000)
MONGODB_CONNECT_TIMEOUT_MS=5000

# Fallback individual settings (used only if MONGODB_URI is not set)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_OPTIONS=replicaSet=rs0&authSource=admin
