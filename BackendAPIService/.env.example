# BackendAPIService example environment

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=3001

# MongoDB connection (required to enable DB access)
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017
# For MongoDB Atlas (example; replace credentials/host):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=myapp
MONGODB_URI=

# TLS and timeouts (optional)
# MONGODB_TLS=true
# MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS (optional)
# BACKEND_CORS_ORIGINS=http://localhost:3000
# CORS_SUPPORTS_CREDENTIALS=false

# Notes:
# - The application always uses database 'network_devices' and collection 'devices'.
# - Unique index on ip_address is ensured automatically on first DB access.
