# Flask settings
# FLASK_ENV: Flask environment mode (development/production/testing)
FLASK_ENV=development
# FLASK_DEBUG: Enable Flask debugger (1 to enable in development only)
FLASK_DEBUG=1
# PORT: The port the Flask app should bind to (default 3001)
PORT=3001

# MongoDB settings
# MONGODB_URI: MongoDB connection string (Atlas or standard). May include db path.
# Example Atlas:
#   mongodb+srv://<user>:<pass>@cluster0.mongodb.net/network?retryWrites=true&w=majority&appName=myapp
# Example Local:
#   mongodb://localhost:27017/network
MONGODB_URI="mongodb+srv://db_user:vettel%402012@cluster0.htz84wq.mongodb.net/network?retryWrites=true&w=majority&appName=Cluster0"

# MONGODB_DB_NAME: Database name to use (overrides db name in URI if both present)
MONGODB_DB_NAME="network_devices"

# CORS configuration
# ALLOWED_ORIGINS: Set to "*" to allow all origins (development/preview).
# In production, replace with a comma-separated allowlist (e.g., "https://example.com,http://localhost:3000").
ALLOWED_ORIGINS="*"
